<!DOCTYPE html>
<html lang="tr" data-bs-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Firewall Agent — Login</title>

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">

  <style>
    :root{
      --bg:#0b0f12;
      --panel:#0e1316;
      --accent:#00e6a8;
      --muted:#9aa6b2;
      --danger:#ff6b6b;
      --glass: rgba(255,255,255,0.03);
      --mono: "JetBrains Mono", "Fira Mono", "Courier New", monospace;
    }

    html,body{ height:100%; background: radial-gradient(1200px 600px at 10% 10%, rgba(0,230,168,0.03), transparent), var(--bg); color:#dbe7ea; font-family: var(--mono); }
    .wrap { min-height:100vh; display:flex; align-items:center; justify-content:center; padding:24px; }
    .card-auth { width:100%; max-width:920px; border-radius:12px; background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01)); border:1px solid rgba(255,255,255,0.04); box-shadow: 0 10px 30px rgba(2,6,8,0.6); overflow:hidden; display:grid; grid-template-columns: 420px 1fr; }
    
    .left {
      padding:28px;
      background:
        linear-gradient(180deg, rgba(255,255,255,0.01), rgba(255,255,255,0.00)),
        url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="400" height="400"><rect width="100%" height="100%" fill="%23060b0d"/></svg>');
      border-right:1px solid rgba(255,255,255,0.02);
      display:flex; flex-direction:column; gap:12px; align-items:flex-start; justify-content:center;
    }

    .brand {
      display:flex; gap:12px; align-items:center;
    }
    .brand .logo {
      width:56px; height:56px; border-radius:8px; display:inline-grid; place-items:center; font-weight:700;
      background: linear-gradient(135deg, rgba(0,230,168,0.12), rgba(0,160,120,0.06)); color:var(--accent);
      border:1px solid rgba(0,230,168,0.08);
      font-size:20px;
    }
    .brand h1 { margin:0; font-size:18px; color:var(--accent); letter-spacing:0.6px; }
    .brand p { margin:2px 0 0 0; color:var(--muted); font-size:12px; }

    .desc { margin-top:18px; color:var(--muted); font-size:13px; line-height:1.4; }
    .pill { margin-top:14px; display:inline-block; font-size:12px; color:#05110a; background:var(--accent); padding:6px 10px; border-radius:999px; }

    .right { padding:28px; display:flex; flex-direction:column; gap:14px; align-items:stretch; justify-content:center; }

    label small { color:var(--muted); font-family:var(--mono); }
    .form-control { background:var(--glass); color: #e6f7f1; border:1px solid rgba(255,255,255,0.03); font-family:var(--mono); }
    .form-control:focus { box-shadow:0 0 0 4px rgba(0,230,168,0.04); border-color: rgba(0,230,168,0.16); outline:none; color:#dffbf0; }

    .btn-primary {
      background: linear-gradient(90deg, #00e6a8, #00b389);
      border: none; color:#03120c; font-weight:700; font-family:var(--mono);
      box-shadow: 0 6px 18px rgba(0,230,168,0.06);
    }

    .meta { font-size:12px; color:var(--muted); display:flex; gap:8px; align-items:center; justify-content:space-between; }
    .error-box { background: rgba(255,107,107,0.06); border:1px solid rgba(255,107,107,0.08); color:var(--danger); padding:8px 10px; border-radius:6px; font-family:var(--mono); }

    .footer-note { font-size:11px; color:var(--muted); text-align:center; padding:10px 0 4px 0; }
    @media (max-width:880px) {
      .card-auth { grid-template-columns: 1fr; }
      .left { border-right:none; border-bottom:1px solid rgba(255,255,255,0.02); }
    }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="card-auth">
      <div class="left">
        <div class="brand">
          <div class="logo">AP</div>
          <div>
            <h1>AgenPower Firewall</h1>
            <p>Remote agent control • AES-GCM • Secure channel</p>
          </div>
        </div>

        <div class="desc">
          <strong style="color:var(--accent);">Admin access</strong><br>
          Giriş yaparak bağlı ajanları yönetebilir, whitelist / blocklist işlemleri gerçekleştirebilirsin. Tüm komutlar AES-256-GCM ile şifrelenir. Oturumun kapalıysa giriş yap.
        </div>

        <span class="pill">Secure UI • CSRF enabled</span>

        <div style="margin-top:18px; width:100%; display:flex; gap:10px; align-items:center;">
          <div style="flex:1;">
            <small style="color:var(--muted); font-size:11px">Version</small>
            <div style="font-family:var(--mono); color:#9fdcc1; font-size:13px">agenpower v1.0</div>
          </div>
          <div style="text-align:right;">
            <small style="color:var(--muted); font-size:11px">Host</small>
            <div style="font-family:var(--mono); color:#9fdcc1; font-size:13px">
                
              </div>
          </div>
        </div>
      </div>

      <div class="right">
        <div style="display:flex; align-items:center; justify-content:space-between;">
          <h3 style="margin:0; font-family:var(--mono); color:#dffbf0;">Sign in</h3>
          <small class="meta">Protected area</small>
        </div>

        <% if (error && error.length) { %>
          <div class="error-box"><%= error %></div>
        <% } %>

        <form method="POST" action="/login" autocomplete="off" style="display:flex; flex-direction:column; gap:10px;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div>
            <label class="form-label"><small>USERNAME</small></label>
            <input name="username" required autocomplete="username" class="form-control form-control-lg" placeholder="admin" />
          </div>

          <div>
            <label class="form-label"><small>PASSWORD</small></label>
            <input name="password" type="password" required autocomplete="current-password" class="form-control form-control-lg" placeholder="••••••••" />
          </div>

          <div style="display:flex; gap:10px; align-items:center; justify-content:space-between; margin-top:6px;">
            <div style="font-size:12px; color:var(--muted);">
              <input type="checkbox" id="r" name="remember" /> <label for="r" style="color:var(--muted)">Remember</label>
            </div>
            <div style="font-size:12px; color:var(--muted)"><a href="#" style="color:var(--accent); text-decoration:none">Forgot?</a></div>
          </div>

          <div style="display:flex; gap:10px; margin-top:6px;">
            <button type="submit" class="btn btn-primary w-100">Sign in</button>
          </div>
        </form>

        <div class="footer-note">
          <div>By signing in you accept admin policies. All actions are logged.</div>
        </div>
      </div>
    </div>
  </div>

  <!-- bootstrap bundle -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
</body>
</html>
