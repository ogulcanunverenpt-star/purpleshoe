<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Firewall Agent Control Panel</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="/socket.io/socket.io.js"></script>
  <style>
    body { padding: 20px; }
    .agent-card {
      cursor: pointer;
      transition: transform 0.2s;
    }
    .agent-card:hover {
      transform: scale(1.05);
    }
    .agent-icon {
      font-size: 3rem;
      color: #0dcaf0;
    }
  </style>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container-fluid">
      <a class="navbar-brand" href="/">Firewall Agent Control</a>
      <div class="navbar-nav">
        <a class="nav-link" href="/logout">Logout</a>
      </div>
    </div>
  </nav>

  <div class="container">
    <h2 class="mb-4 text-info">Connected Agents</h2>
    <div id="agent-list" class="row g-3">
      <% agents.forEach(agent => { %>
        <div class="col-md-3">
          <div class="card bg-dark border-info text-light agent-card" onclick="location.href='/agent/<%= agent.name %>'">
            <div class="card-body text-center">
              <div class="agent-icon">🖥️</div>
              <h5 class="card-title mt-2"><%= agent.name %></h5>
              <p class="text-secondary"><%= agent.remote || "N/A" %></p>
              <p class="text-success">Connected: <%= new Date(agent.connectedAt).toLocaleString() %></p>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</body>
</html>
