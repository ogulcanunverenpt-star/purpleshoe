[gd_scene format=3]

[ext_resource type="Script" path="res://character_select.gd" id="1_script"]
[ext_resource type="Theme" path="res://themes/soft_retro/soft_retro.tres" id="2_theme"]

[sub_resource type="Environment" id="Environment_preview"]
background_mode = 1
background_color = Color(0.12, 0.1, 0.17, 1)
ambient_light_source = 2
ambient_light_color = Color(0.68, 0.62, 0.8, 1)
ambient_light_energy = 0.8

[sub_resource type="PlaneMesh" id="Plane_preview"]
size = Vector2(20, 20)

[sub_resource type="StandardMaterial3D" id="FloorMaterial"]
albedo_color = Color(0.2, 0.18, 0.25, 1)
roughness = 0.9

[node name="CharacterSelect" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_script")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.09, 0.07, 0.13, 1)
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_left = 0.04
anchor_top = 0.025
anchor_right = 0.96
anchor_bottom = 0.975
grow_horizontal = 2
grow_vertical = 2

[node name="Margin" type="MarginContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/margin_left = 18
theme_override_constants/margin_top = 14
theme_override_constants/margin_right = 18
theme_override_constants/margin_bottom = 14

[node name="VBox" type="VBoxContainer" parent="Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 34
text = "CHOOSE YOUR CHARACTER"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
text = "Explore the lobby with this character"
horizontal_alignment = 1

[node name="Preview" type="SubViewportContainer" parent="Panel/Margin/VBox"]
custom_minimum_size = Vector2(0, 320)
layout_mode = 2
size_flags_vertical = 3
stretch = true

[node name="Viewport" type="SubViewport" parent="Panel/Margin/VBox/Preview"]
size = Vector2i(960, 640)
render_target_update_mode = 3
own_world_3d = true

[node name="World" type="Node3D" parent="Panel/Margin/VBox/Preview/Viewport"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="Panel/Margin/VBox/Preview/Viewport/World"]
environment = SubResource("Environment_preview")

[node name="DirectionalLight3D" type="DirectionalLight3D" parent="Panel/Margin/VBox/Preview/Viewport/World"]
rotation = Vector3(-0.785398, -0.436332, 0)
light_energy = 1.35
shadow_enabled = true

[node name="Camera3D" type="Camera3D" parent="Panel/Margin/VBox/Preview/Viewport/World"]
transform = Transform3D(1, 0, 0, 0, 0.999201, 0.0399893, 0, -0.0399893, 0.999201, 0, 1.05, 4.2)
current = true
fov = 38.0

[node name="Floor" type="MeshInstance3D" parent="Panel/Margin/VBox/Preview/Viewport/World"]
mesh = SubResource("Plane_preview")
surface_material_override/0 = SubResource("FloorMaterial")

[node name="PreviewRoot" type="Node3D" parent="Panel/Margin/VBox/Preview/Viewport/World"]

[node name="AvatarChoices" type="GridContainer" parent="Panel/Margin/VBox"]
layout_mode = 2
columns = 2
theme_override_constants/h_separation = 10
theme_override_constants/v_separation = 8

[node name="Man" type="Button" parent="Panel/Margin/VBox/AvatarChoices"]
custom_minimum_size = Vector2(0, 52)
layout_mode = 2
toggle_mode = true
text = "MALE"

[node name="Journalist" type="Button" parent="Panel/Margin/VBox/AvatarChoices"]
custom_minimum_size = Vector2(0, 52)
layout_mode = 2
toggle_mode = true
text = "REPORTER"

[node name="Goalkeeper" type="Button" parent="Panel/Margin/VBox/AvatarChoices"]
custom_minimum_size = Vector2(0, 52)
layout_mode = 2
toggle_mode = true
text = "GOALKEEPER"

[node name="Robot" type="Button" parent="Panel/Margin/VBox/AvatarChoices"]
custom_minimum_size = Vector2(0, 52)
layout_mode = 2
toggle_mode = true
text = "ROBOT"

[node name="SelectedLabel" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
horizontal_alignment = 1
text = "Selected character: Male"

[node name="StatusLabel" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
horizontal_alignment = 1
autowrap_mode = 2
text = "The model preview rotates in a T-pose. Your selection is saved to your account."

[node name="ContinueButton" type="Button" parent="Panel/Margin/VBox"]
