; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="voip-3d"
run/main_scene="res://lobby.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://kbsk1tp0qxmt"
driver/enable_input=true

[autoload]

MatchManager="*res://match_manager.gd"
AudioManager="*res://openworld/audio_manager.gd"
NetJoin="*res://net_join.gd"
MatrixClient="*res://matrix_client.gd"

[dotnet]

project/assembly_name="voip-3d"

[filesystem]

import/blender/enabled=false

